<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for Craft Anything. Add exceptions here only with a reason
     in a comment. The app is pure Rust, loads no unsigned code, needs no JIT, and is not
     sandboxed (it opens files by path, from the command line and drag-and-drop). -->
<plist version="1.0">
<dict>
  <!-- Send Apple Events to another app the person asked Craft Anything to control
       (through a plugin that drives it via Apple Events). Without this entitlement
       the hardened runtime silently blocks the events and macOS never shows the
       Automation consent prompt (#1939). -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
